#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "Work4"
      VALUE "FileDescription", "Work4 File Search"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "work4-tools"
      VALUE "OriginalFilename", "work4-tools.exe"
      VALUE "ProductName", "Work4 File Search"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
